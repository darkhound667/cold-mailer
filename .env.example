# Copy this file to .env and fill in your own values. Never commit the real .env.

# Display name used in the "From" header and email signature.
SENDER_NAME="Your Name"

# The mailbox you're sending from.
SENDER_EMAIL="you@example.edu"

# An app-specific password / token for your mail provider — NOT your regular account
# password. Most institutional and personal providers (Gmail, Outlook, most university
# webmail) support generating one of these under account security settings.
SENDER_APP_TOKEN="paste-your-app-token-here"

# SMTP relay for your provider (examples — check your provider's docs).
SMTP_SERVER="smtp.example.edu"
SMTP_PORT=587

# Optional: IMAP settings, only needed if you want the mailer to save a copy of each
# sent message into your Sent folder. Some institutional networks restrict IMAP to
# on-campus/VPN access even when SMTP works fine from anywhere — if so, just leave
# SAVE_TO_SENT=false and skip this.
IMAP_SERVER="imap.example.edu"
IMAP_PORT=993
SAVE_TO_SENT=false

# Path to your resume/CV PDF, attached to every outgoing email.
RESUME_PATH="./resume.pdf"
